# Konfiguracja wdrozenia kontenerowego backendu.
# Skopiowac jako .env i podmienic wartosci; docker compose czyta ten plik
# automatycznie. .env jest wykluczony z repozytorium.

# --- Baza danych ---
POSTGRES_DB=loyalty_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
# Port bazy widoczny na hoscie (tylko dla narzedzi deweloperskich).
DB_HOST_PORT=5433

# --- Backend ---
BACKEND_HOST_PORT=8089
# Klucz podpisu JWT, Base64. NA PRODUKCJI USTAWIC WLASNY.
JWT_SECRET=YWRtaW5Mb3lhbHR5Q2x1YlNlY3JldEtleUFkbWluTG95YWx0eUNsdWJTZWNyZXRLZXk=
# Originy SPA dopuszczone do CORS, po przecinku. Puste = jeden origin
# (nginx frontendu przekazuje /api do backendu), czyli CORS zbedny.
CORS_ALLOWED_ORIGINS=
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+UseG1GC

# --- Konta poczatkowe -------------------------------------------------------
# Seedery kont sa domyslnie WYLACZONE. Wlaczaj je wylacznie w srodowisku
# deweloperskim, na pustej bazie; wdrozenie produkcyjne zostawia ponizsza
# zmienna nieustawiona albo rowna "false" i zaklada konta swiadomie.
LOYALTYCLUB_SEED_ENABLED=false

# Hasla kont zakladanych przy starcie. Ponizsze pola sa CELOWO PUSTE i nie maja
# wartosci domyslnych nigdzie w kodzie - przy LOYALTYCLUB_SEED_ENABLED=true
# i pustym hasle aplikacja nie wstanie. Wypelnij je we wlasnym pliku .env,
# ktory nie trafia do repozytorium.
#
# Wygenerowanie wartosci:
#   openssl rand -base64 24
#
# NIE wpisuj tu prawdziwych hasel - ten plik jest wersjonowany.
LOYALTYCLUB_SEED_ADMIN_PASSWORD=
LOYALTYCLUB_SEED_STORE_PASSWORD=
LOYALTYCLUB_SEED_ECOM_PASSWORD=

# --- Obraz ---
BACKEND_IMAGE=loyaltyclub/backend
IMAGE_TAG=local
