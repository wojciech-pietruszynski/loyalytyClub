# Konfiguracja wdrozenia kontenerowego backendu.
# Skopiowac jako .env i podmienic wartosci; docker compose czyta ten plik
# automatycznie. .env jest wykluczony z repozytorium.

# --- Baza danych ---
POSTGRES_DB=loyalty_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
# Port bazy widoczny na hoscie (tylko dla narzedzi deweloperskich).
DB_HOST_PORT=5433

# --- Backend ---
BACKEND_HOST_PORT=8089
# Klucz podpisu JWT, Base64. NA PRODUKCJI USTAWIC WLASNY.
JWT_SECRET=YWRtaW5Mb3lhbHR5Q2x1YlNlY3JldEtleUFkbWluTG95YWx0eUNsdWJTZWNyZXRLZXk=
# Originy SPA dopuszczone do CORS, po przecinku. Puste = jeden origin
# (nginx frontendu przekazuje /api do backendu), czyli CORS zbedny.
CORS_ALLOWED_ORIGINS=
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+UseG1GC

# --- Obraz ---
BACKEND_IMAGE=loyaltyclub/backend
IMAGE_TAG=local
