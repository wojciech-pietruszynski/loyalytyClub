hide empty members

package "api.store.security" {
  class StoreUserDetailsService #EDE7F6 {
    - storeUserRepository : StoreUserRepository
    + loadUserByUsername() : UserDetails
  }
}
package "api.store.service" {
  class HierarchyPromotionService #EDE7F6 {
    - hierarchyPromotionRepository : HierarchyPromotionRepository
    + getActivePromotions() : List<HierarchyPromotion>
    + isItemExcluded() : boolean
    + resolveItemMultiplier() : BigDecimal
  }
  class StorePromotionService #EDE7F6 {
    - storePointsPromotionRepository : StorePointsPromotionRepository
    - defaultPointsPerCurrency : BigDecimal
    + resolvePointsPerCurrency() : BigDecimal
  }
  class StoreTransactionService #EDE7F6 {
    - ZERO : BigDecimal
    - customerRepository : CustomerRepository
    - transactionRepository : TransactionRepository
    - storePromotionService : StorePromotionService
    - hierarchyPromotionService : HierarchyPromotionService
    - customerPointsService : CustomerPointsService
    - referralRewardService : ReferralRewardService
    + registerSale() : StoreTransactionResponse
    + registerReturn() : StoreTransactionResponse
    + getPointsBalance() : StorePointsBalanceResponse
  }
}
package "powiazania spoza tej strony" #F0F0F0 {
  class CustomerPointsService #F0F0F0
  class CustomerRepository #F0F0F0
  class EcomService #F0F0F0
