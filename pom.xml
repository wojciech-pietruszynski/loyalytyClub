<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.3</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>pl.pietruszynski</groupId>
    <artifactId>loyalty-club</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>loyalty-club</name>
    <description>Loyalty Program Application</description>
    <properties>
        <java.version>21</java.version>
        <springdoc.version>2.3.0</springdoc.version>
        <!--
            Wersja zarzadzana przez spring-boot-starter-parent (1.18.30) nie obsluguje
            JDK nowszych niz 21 i przy budowaniu na nich cicho przestaje generowac kod.
            Projekt kompiluje sie do Javy 21, ale musi dac sie zbudowac takze
            nowszym zestawem narzedzi.
        -->
        <lombok.version>1.18.42</lombok.version>
        <!--
            Wersje zarzadzane przez spring-boot-starter-parent (Mockito 5.7.0
            z Byte Buddy 1.14.12) nie potrafia instrumentowac klas na JDK 25;
            wszystkie testy z mockami wywalaja sie wtedy na
            "Could not modify all classes". Byte Buddy podnosimy razem
            z Mockito, bo zarzadzanie zaleznosciami Boota nadpisalo by wersje
            przechodnia z Mockito.
        -->
        <mockito.version>5.23.0</mockito.version>
        <byte-buddy.version>1.17.7</byte-buddy.version>
        <!--
            Wartosc domyslna dla argLine JaCoCo. Nadpisywana przez prepare-agent;
            pusta wartosc pozwala zbudowac projekt takze z -Djacoco.skip=true,
            gdy prepare-agent w ogole nie ustawi tej wlasciwosci.
        -->
        <jacocoArgLine></jacocoArgLine>
        <!-- SonarQube -->
        <sonar.projectKey>loyalty-club</sonar.projectKey>
        <sonar.host.url>http://192.168.100.150:9000</sonar.host.url>
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <sonar.exclusions>
            **/config/**,
            **/LoyaltyClubApplication.java
        </sonar.exclusions>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <!--
            Specyfikacja OpenAPI generowana z kodu. Odblokowuje generowanie SDK
            (w tym w C#), testy kontraktowe i wykrywanie rozjazdu miedzy kontraktem
            a biblioteka klienta w czasie budowania, a nie dopiero w czasie dzialania.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Sciezka procesorow adnotacji podana jawnie. Od JDK 23 javac nie
                uruchamia procesorow znalezionych na sciezce klas, wiec bez tej
                konfiguracji Lombok przestaje generowac kod przy budowaniu nowszym
                zestawem narzedzi; bledy wygladaja wtedy jak brakujace metody
                w kodzie, nie jak problem z konfiguracja budowania.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!--
                Mockito dolacza agenta Byte Buddy w trakcie dzialania JVM.
                Od JDK 21 takie doladowanie wypisuje ostrzezenie, a docelowo
                ma byc domyslnie zabronione; flaga wlacza je swiadomie.
                @{jacocoArgLine} dokleja agenta pokrycia, ktory bez tego
                zostalby nadpisany przez wlasne argLine.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{jacocoArgLine} -XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <!--
                    0.8.11 nie zna formatu plikow klas z JDK 25 i wysypuje sie
                    przy instrumentacji klas mockow generowanych w locie.
                -->
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                        <configuration>
                            <propertyName>jacocoArgLine</propertyName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>4.0.0.4121</version>
            </plugin>
        </plugins>
    </build>

</project>
