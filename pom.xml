<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>pl.pietruszynski</groupId>
    <artifactId>loyalty-club</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>loyalty-club</name>
    <description>Loyalty Program Application</description>
    <properties>
        <java.version>25</java.version>
        <springdoc.version>2.8.17</springdoc.version>
        <jjwt.version>0.13.0</jjwt.version>
        <!--
            Wersja zarzadzana przez spring-boot-starter-parent nie obsluguje
            jeszcze formatu plikow klas Javy 25 i przy budowaniu cicho przestaje
            generowac kod. Projekt kompiluje sie do Javy 25, wiec Lombok musi byc
            nowszy niz to, co przynosi Boot.
        -->
        <lombok.version>1.18.46</lombok.version>
        <!--
            Wersje zarzadzane przez spring-boot-starter-parent nie potrafia
            instrumentowac klas na JDK 25; wszystkie testy z mockami wywalaja sie
            wtedy na "Could not modify all classes". Byte Buddy podnosimy razem
            z Mockito, bo zarzadzanie zaleznosciami Boota nadpisaloby wersje
            przechodnia z Mockito.
        -->
        <mockito.version>5.23.0</mockito.version>
        <byte-buddy.version>1.18.12</byte-buddy.version>
        <!--
            Wartosc domyslna dla argLine JaCoCo. Nadpisywana przez prepare-agent;
            pusta wartosc pozwala zbudowac projekt takze z -Djacoco.skip=true,
            gdy prepare-agent w ogole nie ustawi tej wlasciwosci.
        -->
        <jacocoArgLine></jacocoArgLine>
        <!-- SonarQube -->
        <sonar.projectKey>loyalty-club</sonar.projectKey>
        <sonar.host.url>http://192.168.100.150:9000</sonar.host.url>
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <sonar.exclusions>
            **/config/**,
            **/LoyaltyClubApplication.java
        </sonar.exclusions>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!--
            Sonda gotowosci dla orkiestracji kontenerow. Bez niej docker compose
            potrafi sprawdzic tylko, czy port jest otwarty, a Spring otwiera go
            zanim skoncza sie migracje Liquibase - kontener zglaszalby gotowosc
            wczesniej, niz aplikacja realnie obsluguje zadania. Wystawiony jest
            wylacznie /actuator/health (patrz application.properties).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!--
            Specyfikacja OpenAPI generowana z kodu. Odblokowuje generowanie SDK
            (w tym w C#), testy kontraktowe i wykrywanie rozjazdu miedzy kontraktem
            a biblioteka klienta w czasie budowania, a nie dopiero w czasie dzialania.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Podany wprost, mimo ze wchodzi przechodnio ze spring-boot-starter-test.
            maven-dependency-plugin wystawia sciezke do tego artefaktu jako wlasciwosc,
            z ktorej surefire buduje -javaagent (patrz konfiguracja surefire nizej).
        -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Pozwala wykonac zadanie w tescie z konkretna rola i tym samym sprawdzic
            regulami dostepu z SecurityConfig na pelnym lancuchu filtrow. Bez tego
            rozdzial na role panelu, kasy i sklepu internetowego byl opisany
            wylacznie w konfiguracji i nieweryfikowany.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Baza w pamieci dla testow warstwy persystencji i testow integracyjnych.
            Swiadomie zamiast Testcontainers: potok CI uruchamia testy wewnatrz
            "docker build" (etap test w Dockerfile), gdzie nie ma dostepu do demona
            Dockera. Schemat dla testow tworzy Hibernate z mapowan encji, a nie
            Liquibase, bo migracje sa pisane w SQL PostgreSQL-a (patrz
            src/test/resources/application-test.properties).
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Sciezka procesorow adnotacji podana jawnie. Od JDK 23 javac nie
                uruchamia procesorow znalezionych na sciezce klas, wiec bez tej
                konfiguracji Lombok przestaje generowac kod przy budowaniu nowszym
                zestawem narzedzi; bledy wygladaja wtedy jak brakujace metody
                w kodzie, nie jak problem z konfiguracja budowania.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!--
                Wystawia sciezki do rozwiazanych artefaktow jako wlasciwosci
                (np. ${org.mockito:mockito-core:jar}), zeby surefire mogl podac
                agenta Mockito przez -javaagent.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>resolve-agent-paths</id>
                        <goals><goal>properties</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                Mockito domyslnie doladowuje agenta Byte Buddy do dzialajacej JVM.
                Na JDK 25 takie samodoladowanie wypisuje ostrzezenie, a w kolejnych
                wydaniach ma byc zabronione, wiec podajemy agenta od razu przy starcie.
                @{jacocoArgLine} dokleja agenta pokrycia, ktory bez tego
                zostalby nadpisany przez wlasne argLine.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{jacocoArgLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <!--
                    Wersje starsze niz 0.8.13 nie znaja formatu plikow klas z JDK 25
                    i wysypuja sie przy instrumentacji klas mockow generowanych w locie.
                -->
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                        <configuration>
                            <propertyName>jacocoArgLine</propertyName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <!--
                        Bramka pokrycia. Raport bez progu pokazuje spadek, ale go nie
                        zatrzymuje - kod dopisany bez testow obniza pokrycie, a budowanie
                        nadal przechodzi. Progi ustawione sa nieco ponizej stanu biezacego:
                        maja zatrzymac regres, a nie wymuszac scigania sie o dziesiate
                        czesci procenta przy kazdej zmianie.

                        Wylaczenia obejmuja miejsca, dla ktorych test jednostkowy nie
                        niesie tresci: klase startowa, konfiguracje i obiekty transferowe
                        (rekordy i klasy z samymi akcesorami). Sa one pokryte posrednio
                        przez testy kontrolerow i serwisow, ale nie powinny podbijac
                        ani zanizac wyniku.
                    -->
                    <execution>
                        <id>check</id>
                        <!--
                            Faza "test", a nie domyslna "verify": potok CI i etap test
                            w Dockerfile uruchamiaja "mvn test", wiec bramka zwiazana
                            z pozniejsza faza nigdy by sie nie wykonala. Wykonania
                            w obrebie jednej fazy ida w kolejnosci deklaracji,
                            wiec raport powstaje przed sprawdzeniem progow.
                        -->
                        <phase>test</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <excludes>
                                <exclude>**/LoyaltyClubApplication.class</exclude>
                                <exclude>**/config/**</exclude>
                                <exclude>**/dto/**</exclude>
                            </excludes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.65</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>5.7.0.6970</version>
            </plugin>
        </plugins>
    </build>

</project>
