pipeline {
    agent any

    environment {
        JAVA_HOME = '/usr/lib/jvm/java-21-openjdk-amd64'
        PATH = "${JAVA_HOME}/bin:${env.PATH}"
        TARGET_DIR = '/home/wojciech/loyalty-club-builds'
        ARCHIVE_DIR = "${TARGET_DIR}/archive"
    }

    stages {
        stage('Pobranie kodu') {
            steps {
                checkout scm
            }
        }

        stage('Budowanie Fullstack (Maven)') {
            steps {
                echo '==== Rozpoczynam budowanie ===='
                sh 'mvn clean package -P build-frontend -DskipTests'
            }
        }

        stage('Zatrzymanie i Archiwizacja') {
            steps {
                echo '==== Zatrzymywanie starej wersji ===='
                // Używamy " " zamiane na ' ' aby zmienne ${TARGET_DIR} działały
                sh """
                    # Zabijamy stare procesy - dodajemy || true, żeby nie wywaliło builda jeśli nic nie znajdzie
                    pgrep -f "loyaltyClub.jar" && pkill -9 -f "loyaltyClub.jar" || echo "Proces nie działał."

                    sleep 3

                    mkdir -p ${ARCHIVE_DIR}
                    if [ -f "${TARGET_DIR}/loyaltyClub.jar" ]; then
                        TIMESTAMP=\$(date +"%Y%m%d_%H%M%S")
                        mv "${TARGET_DIR}/loyaltyClub.jar" "${ARCHIVE_DIR}/loyaltyClub_\${TIMESTAMP}.jar"
                    fi
                """
            }
        }

        stage('Kopiowanie (Deploy)') {
            steps {
                sh "cp target/*.jar ${TARGET_DIR}/loyaltyClub.jar"
            }
        }

        stage('Uruchomienie Aplikacji') {
            steps {
                echo '==== Uruchamianie nowej wersji ===='
                // Używamy JENKINS_NODE_COOKIE, aby Jenkins nie zabił procesu po zakończeniu joba
                sh """
                    export JENKINS_NODE_COOKIE=dontKillMe
                    nohup java -jar ${TARGET_DIR}/loyaltyClub.jar > ${TARGET_DIR}/application.log 2>&1 &

                    # Opcjonalnie: sprawdźmy czy proces w ogóle ruszył
                    sleep 5
                    pgrep -f "loyaltyClub.jar" || (echo "BŁĄD: Aplikacja nie wystartowała!" && exit 1)
                """
            }
        }
    }

    post {
        success {
            echo "==== Wdrożono pomyślnie ===="
        }
        failure {
            echo "==== BŁĄD builda ===="
        }
    }
}