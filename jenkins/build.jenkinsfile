pipeline {
    agent any

    environment {
        JAVA_HOME = '/usr/lib/jvm/java-21-openjdk-amd64'
        PATH = "${JAVA_HOME}/bin:${env.PATH}"
        TARGET_DIR = '/home/wojciech/loyalty-club-builds'
    }

    stages {
        stage('Pobranie kodu') {
            steps {
                checkout scm
            }
        }

        stage('Budowanie Fullstack (Maven)') {
            steps {
                echo '==== Rozpoczynam budowanie z profilem build-frontend ===='
                // Uruchamiamy Mavena z profilem -P build-frontend
                // -DskipTests pominie testy Javy oraz testy NPM (faza test w pluginie)
                sh 'mvn clean package -P build-frontend -DskipTests'
            }
        }

        stage('Kopiowanie (Deploy)') {
            steps {
                echo '==== Kopiowanie gotowego pliku .jar ===='
                sh 'cp target/*.jar ${TARGET_DIR}/loyaltyClub.jar'
            }
        }
    }

    post {
        success {
            echo "==== SUKCES: Nowa wersja aplikacji wraz z frontendem czeka w ${TARGET_DIR} ===="
            // Opcjonalnie: automatyczny restart serwisu po wdrożeniu nowej paczki
            // sh 'sudo systemctl restart loyalty-club'
        }
        failure {
            echo "==== BŁĄD: Coś poszło nie tak podczas budowania. Sprawdź logi. ===="
        }
    }
}