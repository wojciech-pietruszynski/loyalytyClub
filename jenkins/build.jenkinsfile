// Potok CI/CD warstwy serwerowej LoyaltyClub - w calosci na Dockerze.
//
// Na agencie potrzebny jest wylacznie dzialajacy Docker (z BuildKit). JDK,
// Maven ani lokalne repozytorium ~/.m2 nie sa wymagane - kazdy krok wykonuje
// sie w kontenerze zbudowanym z Dockerfile w korzeniu repozytorium.
//
// Wynikiem jest dzialajacy kontener "loyalty-backend" w sieci
// "loyaltyclub-net", do ktorej podlacza sie wdrozenie frontendu.

pipeline {
    agent any

    options {
        timestamps()
        // Rownolegle przebiegi walczylyby o te same nazwy kontenerow i port.
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        BACKEND_IMAGE = 'loyaltyclub/backend'
        // Numer budowania jako znacznik obrazu daje mozliwosc wskazania
        // konkretnej wersji przy wycofywaniu zmian.
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        // Wymuszamy BuildKit - bez niego nie dzialaja cele wieloetapowe
        // z --secret i --output uzywane nizej.
        DOCKER_BUILDKIT = '1'
    }

    stages {
        stage('Pobranie kodu') {
            steps {
                checkout scm
            }
        }

        stage('Testy jednostkowe') {
            steps {
                echo '==== Testy jednostkowe w kontenerze ===='
                // Cel test-reports wystawia surefire i JaCoCo do katalogu na
                // dysku agenta; pliki naleza do uzytkownika Jenkinsa, bo
                // zapisuje je BuildKit, a nie proces roota w kontenerze.
                sh 'bash ./scripts/stack.sh test'
            }
            post {
                always {
                    junit 'target/docker-reports/surefire-reports/*.xml'
                    publishHTML(target: [
                        reportDir            : 'target/docker-reports/jacoco',
                        reportFiles          : 'index.html',
                        reportName           : 'Pokrycie kodu (JaCoCo)',
                        keepAll              : true,
                        alwaysLinkToLastBuild: true,
                        allowMissing         : true
                    ])
                }
            }
        }

        stage('Analiza SonarQube') {
            steps {
                echo '==== Analiza SonarQube ===='
                withCredentials([string(credentialsId: 'loyalty-club', variable: 'SONAR_TOKEN')]) {
                    // Token trafia do budowania jako sekret BuildKita
                    // (--secret), wiec nie zostaje w warstwach obrazu.
                    sh 'bash ./scripts/stack.sh sonar'
                }
            }
        }

        stage('Budowanie obrazu') {
            steps {
                echo '==== Budowanie obrazu wykonawczego ===='
                sh '''
                    docker build \
                        --target runtime \
                        -t "${BACKEND_IMAGE}:${IMAGE_TAG}" \
                        -t "${BACKEND_IMAGE}:latest" \
                        .
                '''
            }
        }

        stage('Wdrozenie') {
            steps {
                echo '==== Podmiana dzialajacej wersji ===='
                // --no-build: obraz powstal w poprzednim etapie i jest juz
                // oznaczony numerem budowania. compose ma go tylko uruchomic.
                sh '''
                    IMAGE_TAG="${IMAGE_TAG}" docker compose up -d --no-build
                '''
            }
        }

        stage('Test dymny') {
            steps {
                echo '==== Weryfikacja dzialajacej instancji ===='
                // Skrypt czeka na stan healthy kontenera i odpytuje sonde
                // z wnetrza sieci kontenerow.
                sh 'bash ./scripts/stack.sh smoke'
            }
        }
    }

    post {
        success {
            echo "==== WDROZENIE ZAKONCZONE POMYSLNIE (${BACKEND_IMAGE}:${IMAGE_TAG}) ===="
        }
        failure {
            echo '==== WDROZENIE NIEUDANE ===='
            // Logi kontenera sa najszybsza droga do przyczyny, gdy potok
            // przewrocil sie na tescie dymnym.
            sh 'docker compose logs --tail 200 backend || true'
            echo "Wycofanie: IMAGE_TAG=<poprzedni numer> docker compose up -d --no-build"
        }
        always {
            // Obrazy z poprzednich przebiegow zapelnilyby dysk agenta.
            // Warstwy wspoldzielone z biezacym obrazem zostaja nietkniete.
            sh 'docker image prune -f --filter "until=168h" || true'
        }
    }
}
