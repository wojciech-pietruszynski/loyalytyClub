pipeline {
    agent any

    environment {
        JAVA_HOME = '/usr/lib/jvm/java-21-openjdk-amd64'
        PATH = "${JAVA_HOME}/bin:${env.PATH}"
        TARGET_DIR = '/home/wojciech/loyalty-club-builds'
        ARCHIVE_DIR = "${TARGET_DIR}/archive"
        // Ograniczamy RAM dla Javy, aby system nie "wisiał" przy 7GB RAMu
        JAVA_OPTS = "-Xms512M -Xmx1G -XX:+UseG1GC"
    }

    stages {
        stage('Pobranie kodu') {
            steps {
                checkout scm
            }
        }

        stage('Testy jednostkowe') {
            steps {
                echo '==== Uruchamiam testy jednostkowe backendu ===='
                sh 'mvn test -P build-backend'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }

        stage('Analiza SonarQube') {
            steps {
                echo '==== Uruchamiam analizę SonarQube ===='
                withCredentials([string(credentialsId: 'loyalty-club', variable: 'SONAR_TOKEN')]) {
                    sh 'mvn sonar:sonar -Dsonar.login=${SONAR_TOKEN}'
                }
            }
        }

        stage('Budowanie Backendu (Maven)') {
            steps {
                echo '==== Rozpoczynam budowanie JAR-a backendu ===='
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Zatrzymanie i Archiwizacja') {
            steps {
                echo '==== Sprzątanie starej wersji ===='
                sh """
                    # Precyzyjne zabijanie tylko procesów java uruchamiających ten konkretny plik
                    # Używamy || true, aby Jenkins nie przerwał buildu, gdy proces nie istnieje
                    echo "Zatrzymywanie starej instancji loyaltyClub..."
                    pkill -9 -f "java.*loyaltyClub.jar" || echo "Nie znaleziono działającej aplikacji."

                    # Chwila na zwolnienie portów przez system
                    sleep 5

                    # Tworzenie folderu archiwum
                    mkdir -p "${ARCHIVE_DIR}"

                    # Archiwizacja starego pliku przed nadpisaniem
                    if [ -f "${TARGET_DIR}/loyaltyClub.jar" ]; then
                        TIMESTAMP=\$(date +"%Y%m%d_%H%M%S")
                        mv "${TARGET_DIR}/loyaltyClub.jar" "${ARCHIVE_DIR}/loyaltyClub_\${TIMESTAMP}.jar"
                        echo "Stary plik zarchiwizowany jako: loyaltyClub_\${TIMESTAMP}.jar"
                    fi
                """
            }
        }

        stage('Kopiowanie (Deploy)') {
            steps {
                echo '==== Kopiowanie nowego artefaktu ===='
                // Szukamy pliku jar w target i kopiujemy do docelowej lokalizacji
                sh "cp target/*.jar ${TARGET_DIR}/loyaltyClub.jar"
            }
        }

        stage('Uruchomienie Aplikacji') {
            steps {
                echo '==== Startowanie nowej wersji w tle ===='
                sh """
                    # Kluczowe dla Jenkinsa: nie zabijaj procesów potomnych po zakończeniu joba
                    export JENKINS_NODE_COOKIE=dontKillMe

                    # Uruchomienie z limitami pamięci i przekierowaniem logów
                    nohup java ${env.JAVA_OPTS} -jar "${TARGET_DIR}/loyaltyClub.jar" > "${TARGET_DIR}/application.log" 2>&1 &

                    echo "Aplikacja startuje... Czekam na weryfikację (15s)..."
                    sleep 15

                    # Sprawdzenie czy proces faktycznie żyje
                    if pgrep -f "java.*loyaltyClub.jar" > /dev/null; then
                        echo "SUKCES: Aplikacja działa poprawnie."
                        pgrep -f "java.*loyaltyClub.jar" | xargs echo "PID procesu:"
                    else
                        echo "BŁĄD: Aplikacja padła zaraz po starcie! Sprawdź logi w ${TARGET_DIR}/application.log"
                        exit 1
                    fi
                """
            }
        }
    }

    post {
        success {
            echo "==== WDROŻENIE ZAKOŃCZONE POMYŚLNIE ===="
        }
        failure {
            echo "==== WDROŻENIE NIEUDANE - Sprawdź konsolę Jenkinsa i logi aplikacji ===="
        }
    }
}